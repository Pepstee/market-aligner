<section data-mw-section-id="19" id="mwBZk" aria-labelledby="List_of_former_group_chairmen"><div class="mw-heading mw-heading4"><h4 id="List_of_former_group_chairmen">List of former group chairmen</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Barclays&amp;action=edit&amp;section=19" title="Edit section: List of former group chairmen"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
