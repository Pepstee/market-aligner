</section><section data-mw-section-id="17" id="mwBXY" aria-labelledby="Branches_and_ATMs"><div class="mw-heading mw-heading3"><h3 id="Branches_and_ATMs">Branches and ATMs</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Barclays&amp;action=edit&amp;section=17" title="Edit section: Branches and ATMs"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwBXc"><a href="//en.wikipedia.org/wiki/File:Barclays_Bank,_Park_Lane_Branch_-_geograph.org.uk_-_218753.jpg" class="mw-file-description" id="mwBXg"><img resource="//en.wikipedia.org/wiki/File:Barclays_Bank,_Park_Lane_Branch_-_geograph.org.uk_-_218753.jpg" src="//upload.wikimedia.org/wikipedia/commons/thumb/5/5c/Barclays_Bank%2C_Park_Lane_Branch_-_geograph.org.uk_-_218753.jpg/250px-Barclays_Bank%2C_Park_Lane_Branch_-_geograph.org.uk_-_218753.jpg" decoding="async" data-file-width="480" data-file-height="640" data-file-type="bitmap" height="333" width="250" srcset="//upload.wikimedia.org/wikipedia/commons/5/5c/Barclays_Bank%2C_Park_Lane_Branch_-_geograph.org.uk_-_218753.jpg 2x" class="mw-file-element" id="mwBXk"/></a><figcaption id="mwBXo">A Barclays branch on <a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/Park_Lane_(road)" title="Park Lane (road)" class="mw-redirect" id="mwBXs">Park Lane</a> in London, United Kingdom</figcaption></figure>
