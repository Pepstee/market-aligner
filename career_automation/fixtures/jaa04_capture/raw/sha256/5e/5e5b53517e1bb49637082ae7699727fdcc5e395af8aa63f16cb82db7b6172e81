</section><section data-mw-section-id="12" id="mwBIk" aria-labelledby="Group_service_centers"><div class="mw-heading mw-heading3"><h3 id="Group_service_centers">Group service centers</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=HSBC&amp;action=edit&amp;section=12" title="Edit section: Group service centers"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
