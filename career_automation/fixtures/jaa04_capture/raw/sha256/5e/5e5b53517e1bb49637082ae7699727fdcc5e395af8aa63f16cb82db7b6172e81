<li id="mwCFw"><a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/Mark_Tucker_(businessman)" title="Mark Tucker (businessman)" id="mwCF0">Sir Mark Tucker</a> (2017–2025)<sup about="#mwt949" class="mw-ref reference" id="cite_ref-310" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-310"}}'><a href="#cite_note-310" id="mwCF4"><span class="mw-reflink-text" id="mwCF8"><span class="cite-bracket" id="mwCGA">[</span>310<span class="cite-bracket" id="mwCGE">]</span></span></a></sup></li></ol>

</section><section data-mw-section-id="40" id="mwCGI" aria-labelledby="List_of_former_group_chief_executives"><div class="mw-heading mw-heading3"><h3 id="List_of_former_group_chief_executives">List of former group chief executives</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=HSBC&amp;action=edit&amp;section=40" title="Edit section: List of former group chief executives"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwCGM">The position of Group Chief Executive was formed in 1991; the preceding position, chief executive of The Hongkong and Shanghai Banking Corporation, has remained a separate position.<sup about="#mwt952" class="mw-ref reference" id="cite_ref-:3_305-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":3"},"body":{"id":"mw-reference-text-cite_note-:3-305"}}'><a href="#cite_note-:3-305" id="mwCGQ"><span class="mw-reflink-text" id="mwCGU"><span class="cite-bracket" id="mwCGY">[</span>305<span class="cite-bracket" id="mwCGc">]</span></span></a></sup></p>
<ol id="mwCGg"><li id="mwCGk"><a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/William_Purves_(banker)" title="William Purves (banker)" id="mwCGo">William Purves</a> (1991–1993)<sup about="#mwt955" class="mw-ref reference" id="cite_ref-311" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-311"}}'><a href="#cite_note-311" id="mwCGs"><span class="mw-reflink-text" id="mwCGw"><span class="cite-bracket" id="mwCG0">[</span>311<span class="cite-bracket" id="mwCG4">]</span></span></a></sup></li>
<li id="mwCG8"><a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/John_Bond_(banker)" title="John Bond (banker)" id="mwCHA">John Bond</a> (1993–1998)<sup about="#mwt958" class="mw-ref reference" id="cite_ref-312" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-312"}}'><a href="#cite_note-312" id="mwCHE"><span class="mw-reflink-text" id="mwCHI"><span class="cite-bracket" id="mwCHM">[</span>312<span class="cite-bracket" id="mwCHQ">]</span></span></a></sup></li>
<li id="mwCHU"><a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/Keith_Whitson" title="Keith Whitson" id="mwCHY">Keith Whitson</a> (1998–2003)<sup about="#mwt961" class="mw-ref reference" id="cite_ref-313" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-313"}}'><a href="#cite_note-313" id="mwCHc"><span class="mw-reflink-text" id="mwCHg"><span class="cite-bracket" id="mwCHk">[</span>313<span class="cite-bracket" id="mwCHo">]</span></span></a></sup></li>
