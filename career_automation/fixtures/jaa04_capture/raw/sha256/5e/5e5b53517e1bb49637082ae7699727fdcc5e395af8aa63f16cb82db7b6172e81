</section><section data-mw-section-id="38" id="mwCC8" aria-labelledby="Leadership"><div class="mw-heading mw-heading2"><h2 id="Leadership">Leadership</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=HSBC&amp;action=edit&amp;section=38" title="Edit section: Leadership"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<ul id="mwCDA"><li id="mwCDE">Group Chairman: Brendan Nelson (December 2025 to present)<sup about="#mwt930" class="mw-ref reference" id="cite_ref-303" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-303"}}'><a href="#cite_note-303" id="mwCDI"><span class="mw-reflink-text" id="mwCDM"><span class="cite-bracket" id="mwCDQ">[</span>303<span class="cite-bracket" id="mwCDU">]</span></span></a></sup></li>
<li id="mwCDY">Group Chief Executive: <a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/Georges_Elhedery" title="Georges Elhedery" id="mwCDc">Georges Elhedery</a> (September 2024 to present)<sup about="#mwt933" class="mw-ref reference" id="cite_ref-304" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-304"}}'><a href="#cite_note-304" id="mwCDg"><span class="mw-reflink-text" id="mwCDk"><span class="cite-bracket" id="mwCDo">[</span>304<span class="cite-bracket" id="mwCDs">]</span></span></a></sup></li></ul>

<section data-mw-section-id="39" id="mwCDw" aria-labelledby="List_of_former_group_chairmen"><div class="mw-heading mw-heading3"><h3 id="List_of_former_group_chairmen">List of former group chairmen</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=HSBC&amp;action=edit&amp;section=39" title="Edit section: List of former group chairmen"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwCD0">The position of Group Chairman was formed in 1991; the preceding position, Chairman of <a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/HSBC_(Hong_Kong)" title="HSBC (Hong Kong)" id="mwCD4">The Hongkong and Shanghai Banking Corporation</a>, has remained a separate position.<sup about="#mwt934" class="mw-ref reference" id="cite_ref-:3_305-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":3"}}'><a href="#cite_note-:3-305" id="mwCD8"><span class="mw-reflink-text" id="mwCEA"><span class="cite-bracket" id="mwCEE">[</span>305<span class="cite-bracket" id="mwCEI">]</span></span></a></sup></p>
<ol id="mwCEM"><li id="mwCEQ"><a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/William_Purves_(banker)" title="William Purves (banker)" id="mwCEU">Sir William Purves</a> (1991–1998); concurrently Group Chief Executive from 1991 to 1993<sup about="#mwt937" class="mw-ref reference" id="cite_ref-306" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-306"}}'><a href="#cite_note-306" id="mwCEY"><span class="mw-reflink-text" id="mwCEc"><span class="cite-bracket" id="mwCEg">[</span>306<span class="cite-bracket" id="mwCEk">]</span></span></a></sup></li>
<li id="mwCEo"><a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/John_Bond_(banker)" title="John Bond (banker)" id="mwCEs">Sir John Bond</a> (1998–2006)<sup about="#mwt940" class="mw-ref reference" id="cite_ref-307" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-307"}}'><a href="#cite_note-307" id="mwCEw"><span class="mw-reflink-text" id="mwCE0"><span class="cite-bracket" id="mwCE4">[</span>307<span class="cite-bracket" id="mwCE8">]</span></span></a></sup></li>
<li id="mwCFA"><a rel="mw:WikiLink" href="//en.wikipedia.org/wiki/Stephen_Green,_Baron_Green_of_Hurstpierpoint" title="Stephen Green, Baron Green of Hurstpierpoint" id="mwCFE">The Lord Green</a> (2006–2010)<sup about="#mwt943" class="mw-ref reference" id="cite_ref-green_308-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"green"},"body":{"id":"mw-reference-text-cite_note-green-308"}}'><a href="#cite_note-green-308" id="mwCFI"><span class="mw-reflink-text" id="mwCFM"><span class="cite-bracket" id="mwCFQ">[</span>308<span class="cite-bracket" id="mwCFU">]</span></span></a></sup></li>
